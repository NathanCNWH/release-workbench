{
  "name": "release-workbench",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "start:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "status": "node scripts/status.mjs",
    "test": "node --test server/test/*.test.mjs",
    "mcp": "node server/mcp.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "node server/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
